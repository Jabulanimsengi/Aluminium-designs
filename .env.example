# Public canonical domain.
NEXT_PUBLIC_SITE_URL=https://www.aluminiumdesigns.co.za


# HTTPS endpoint that receives validated multipart quote requests.
APEX_QUOTE_WEBHOOK_URL=

# Optional absolute path for first-party click monitoring events. Defaults to ./data.
MONITORING_EVENTS_PATH=

# Absolute directory for durable lead records. In production, keep this outside
# versioned release folders (the server default is /var/lib/aluminiumdesigns).
LEADS_DATA_PATH=

# A second append-only live copy written and flushed before a submission is
# acknowledged. Production uses /var/backups/aluminiumdesigns/live.
LEADS_MIRROR_PATH=

# Optional directory used by scripts/backup-leads.sh.
LEADS_BACKUP_PATH=

# Days of monitoring-event history to keep before automatic pruning. Defaults to 180.
# Lead records are not pruned by this setting.
MONITORING_RETENTION_DAYS=

# Required credentials for the private /admin monitoring dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional separate signing secret for admin session cookies. Falls back to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Cloudinary credentials for media storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
